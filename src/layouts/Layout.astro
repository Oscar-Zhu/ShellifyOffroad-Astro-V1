---
interface Props {
  title?: string;
}

const {
  title = "Shellify Offroad | Premium 4x4 Accessories & Vehicle Detailing"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta
        name="description"
        content="Premium 4x4 accessories, professional installation and vehicle detailing in Sydney." />

    <meta
        name="theme-color"
        content="#0b0b0b" />

    <link
        rel="stylesheet"
        href="/styles/global.css" />

</head>

<body>

    <slot />

</body>

</html>