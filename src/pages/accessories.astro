---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; const products=[['roller-shutter','Electric Roller Shutter','BYD Shark 6','Cargo protection with a clean integrated appearance.'],['canopy','Canopy','BYD Shark 6','Enclosed storage for work, touring and everyday use.'],['sports-bar','Sports Bar','BYD Shark 6 / Ute','A strong visual and practical upgrade.'],['cross-bar','Cross Bar','4×4 / Ute','Additional carrying capacity for selected setups.'],['bonnet-protector','Bonnet Protector','BYD Shark 6 / Ute','Added protection for the front edge of the bonnet.'],['nudge-bar','Nudge Bar','4×4 / Ute','Front-end protection with a practical 4×4 look.']];
---
<Layout title="4×4 Accessories | Shellify Offroad"><Header /><main class="page"><div class="hero-small"><p>4×4 ACCESSORIES</p><h1>Built around your ute.</h1><span>Explore selected accessories for BYD Shark 6 and other 4×4 applications.</span></div><div class="list">{products.map(([id,n,f,d])=><article id={id}><div class="visual"></div><div><small>{f}</small><h2>{n}</h2><p>{d}</p><a href="/contact">ENQUIRE →</a></div></article>)}</div></main></Layout>
<style>.page{min-height:100vh;background:#0b0b0b}.hero-small,.list{max-width:1180px;margin:auto;padding-left:22px;padding-right:22px}.hero-small{padding-top:100px;padding-bottom:60px}.hero-small>p,.list small{color:#c9a55b;font-size:11px;letter-spacing:.15em;font-weight:800}.hero-small h1{color:#fff;font-size:clamp(42px,6vw,72px);margin:12px 0}.hero-small span{color:#999;font-size:18px;line-height:1.6}.list{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;padding-bottom:100px}.list article{background:#111;border:1px solid #252525}.visual{height:230px;background:linear-gradient(135deg,#252525,#090909)}article>div:last-child{padding:25px}.list h2{color:#fff}.list p{color:#999;line-height:1.6}.list a{color:#c9a55b;text-decoration:none;font-size:11px;font-weight:800}@media(max-width:700px){.list{grid-template-columns:1fr}}</style>
