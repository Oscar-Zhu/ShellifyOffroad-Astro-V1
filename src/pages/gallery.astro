---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; const images=[['/images/projects/shark-roller.jpg','BYD Shark 6'],['/images/projects/ranger-sportsbar.jpg','Ford Ranger'],['/images/projects/hilux-bullbar.jpg','Toyota Hilux'],['/images/products/canopy.jpg','Canopy'],['/images/products/roller-cover.jpg','Roller Shutter'],['/images/products/sports-bar.jpg','Sports Bar']];
---
<Layout title="Gallery | Shellify Offroad"><Header /><main class="page"><div class="hero-small"><p>GALLERY</p><h1>Recent work.</h1><span>Selected projects, installations and vehicle care.</span></div><div class="gallery">{images.map(([src,alt])=><figure><img src={src} alt={alt} loading="lazy"><figcaption>{alt}</figcaption></figure>)}</div></main></Layout>
<style>.page{min-height:100vh;background:#0b0b0b}.hero-small,.gallery{max-width:1180px;margin:auto;padding-left:22px;padding-right:22px}.hero-small{padding-top:100px;padding-bottom:55px}.hero-small>p{color:#c9a55b;font-size:11px;letter-spacing:.15em;font-weight:800}.hero-small h1{color:#fff;font-size:clamp(42px,6vw,72px);margin:12px 0}.hero-small span{color:#999;font-size:18px}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding-bottom:100px}.gallery figure{margin:0;background:#111;border:1px solid #252525}.gallery img{display:block;width:100%;height:270px;object-fit:cover}.gallery figcaption{padding:15px;color:#ddd;font-size:13px}@media(max-width:800px){.gallery{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.gallery{grid-template-columns:1fr}}</style>
