---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; const services=[['Exterior Detail','Exterior wash and detail focused on a clean, protected finish.'],['Interior Detail','Thorough interior cleaning for seats, carpets, plastics and touch points.'],['Full Detail','A combined interior and exterior service for a complete refresh.'],['Polish & Wax','Paint enhancement followed by protection for a cleaner gloss.'],['Ceramic Coating','Long-term paint protection options for suitable vehicles.']];
---
<Layout title="Vehicle Detailing Sydney | Shellify Offroad"><Header /><main class="page"><div class="hero-small"><p>VEHICLE DETAILING</p><h1>Clean. Restore. Protect.</h1><span>Detailing services for daily drivers, work vehicles and 4×4s across Sydney.</span></div><div class="list">{services.map(([n,d])=><article><small>DETAILING</small><h2>{n}</h2><p>{d}</p><a href="/contact">BOOK / ENQUIRE →</a></article>)}</div></main></Layout>
<style>.page{min-height:100vh;background:#0b0b0b}.hero-small,.list{max-width:1180px;margin:auto;padding-left:22px;padding-right:22px}.hero-small{padding-top:100px;padding-bottom:60px}.hero-small>p,.list small{color:#c9a55b;font-size:11px;letter-spacing:.15em;font-weight:800}.hero-small h1{color:#fff;font-size:clamp(42px,6vw,72px);margin:12px 0}.hero-small span{color:#999;font-size:18px;line-height:1.6}.list{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;padding-bottom:100px}.list article{padding:34px;border:1px solid #252525;background:#111;min-height:200px}.list h2{color:#fff}.list p{color:#999;line-height:1.7}.list a{color:#c9a55b;text-decoration:none;font-size:11px;font-weight:800}@media(max-width:700px){.list{grid-template-columns:1fr}}</style>
